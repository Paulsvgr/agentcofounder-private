{
  "name": "agent-cofounder-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "challenge": "node --import tsx src/run-challenge.ts",
    "validate:result": "node --import tsx src/validate-result.ts",
    "typecheck": "tsc --noEmit",
    "replay:run": "node --import tsx scripts/replay-run.ts",
    "replay:all": "node --import tsx scripts/replay-all.ts",
    "reconcile:run": "node --import tsx scripts/reconcile-run.ts",
    "reconcile:all": "node --import tsx scripts/reconcile-all.ts",
    "normalize:run": "node --import tsx scripts/normalize-run.ts",
    "analyze:run": "node --import tsx scripts/analyze-run.ts",
    "seed:overlay": "node --import tsx scripts/seed-runs-overlay.ts",
    "seed:experiments": "node --import tsx scripts/seed-experiments.ts",
    "config:show": "node --import tsx scripts/show-config.ts",
    "baseline:lock": "bash scripts/run-baseline-lock.sh",
    "assemble:resources": "node --import tsx scripts/assemble-resources.ts",
    "assemble:template": "node --import tsx scripts/assemble-template.ts",
    "preview:assembler": "node --import tsx scripts/preview-assembler.ts",
    "experiment:a": "bash scripts/run-experiment-a.sh",
    "experiment:b": "bash scripts/run-experiment-b.sh",
    "experiment:c": "bash scripts/run-experiment-c.sh",
    "experiment:verify": "bash scripts/run-experiment-verify.sh",
    "experiment:css-vocabulary": "bash scripts/run-experiment-css-vocabulary.sh",
    "experiment:css-vocabulary-v1.1": "bash scripts/run-experiment-css-vocabulary-v1.1.sh",
    "experiment:preinstalled-persistence-v1": "bash scripts/run-experiment-preinstalled-persistence-v1.sh",
    "experiment:q2-test-isolation-v1": "bash scripts/run-experiment-q2-test-isolation-v1.sh",
    "experiment:q2-verify-repair-v1": "bash scripts/run-experiment-q2-verify-repair-v1.sh",
    "experiment:test-authoring-guard-v1": "bash scripts/run-experiment-test-authoring-guard-v1.sh",
    "experiment:q2-early-verify-v1": "bash scripts/run-experiment-q2-early-verify-v1.sh",
    "experiment:q2-harness-owned-test-structure-v1": "bash scripts/run-experiment-q2-harness-owned-test-structure-v1.sh",
    "experiment:ss1-scope-sequence-v1": "bash scripts/run-experiment-ss1-scope-sequence-v1.sh",
    "retro:q2-early-verify-control": "node --import tsx scripts/retro-analyze-q2-early-verify-control.ts",
    "analyze:cohort-trajectory": "node --import tsx scripts/analyze-cohort-trajectory.ts",
    "test": "vitest run",
    "app:test": "npm --prefix app-template-base test -- --passWithNoTests",
    "app:build": "npm --prefix app-template-base run build",
    "check": "npm run typecheck && npm run test && npm run app:test && npm run app:build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
