# The organizer controls these values during official judging.
# Participants may set them locally, but must never commit credentials.
CHALLENGE_PROVIDER=
CHALLENGE_MODEL=
CHALLENGE_THINKING=off
CHALLENGE_TIMEOUT_MS=3600000
EXECUTION_STRATEGY=milestone_ralph
MILESTONE_TIMEOUT_MS=900000
MILESTONE_MAX_SLICES=3
CONTEXT_INTELLIGENCE=1
RALPH_ADAPTIVE=1
# VOI_STOP_THRESHOLD=0.35
# CONTEXT_COMPACT_AT_FRACTION=0.8
# The runner does not load this file. Export the variables in your shell before `npm run challenge`.
# Without exports, code defaults are CHALLENGE_TIMEOUT_MS=3600000 (60m), MILESTONE_TIMEOUT_MS=900000 (15m), MILESTONE_MAX_SLICES=3.
# Context intelligence + adaptive VOI are ON by default; set CONTEXT_INTELLIGENCE=0 or RALPH_ADAPTIVE=0 to disable.
# Optional: load an optimized harness from `npm run rhi` (production stays on coded v0 if unset)
# RHI_HARNESS=harness_history/<run>/optimized_harness.json
