{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": [
    "src/pages/AddRunPage.tsx",
    "src/pages/EditRunPage.tsx",
    "src/pages/FixRatingPage.tsx",
    "src/pages/CohortPage.tsx",
    "src/pages/HowToPage.tsx",
    "src/pages/LaunchRunPage.tsx",
    "src/components/RunsCharts.tsx",
    "src/components/CohortActionFlow.tsx",
    "src/components/RunActionModal.tsx",
    "src/components/ExperimentStudyPanel.tsx",
    "src/components/ExperimentStudyCard.tsx",
    "src/components/ExperimentTrajectoryCharts.tsx",
    "src/components/ClassificationFields.tsx",
    "src/components/HowToExportPanel.tsx",
    "src/components/RunManifestPanel.tsx",
    "src/components/ActionFlowChart.tsx",
    "src/components/Layout.tsx",
    "src/components/TokenStats.tsx",
    "src/lib/actionFlow.ts",
    "src/lib/classification.ts",
    "src/lib/classificationForm.ts",
    "src/lib/cohortStudy.ts",
    "src/lib/efficiencyFields.ts",
    "src/lib/experimentCatalog.ts",
    "src/lib/experimentTrajectory.ts",
    "src/lib/manifestFields.ts",
    "src/lib/parseExport.ts",
    "src/lib/runManifest.ts",
    "src/lib/runPatch.ts",
    "src/lib/stats.ts",
    "src/lib/theme.tsx"
  ]
}
